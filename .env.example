# ============================================
# Trading Bot Configuration
# ============================================

# Binance API Configuration
# Get keys from: https://www.binance.com/en/my/settings/api-management
# Testnet keys: https://testnet.binancefuture.com/
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true
BINANCE_RECV_WINDOW=5000

# Telegram Configuration
# Create bot: @BotFather
# Get chat ID: @userinfobot or @getmyid_bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ENABLED=true
TELEGRAM_RATE_LIMIT=1.0
TELEGRAM_ASYNC=true

# ============================================
# Trading Settings
# ============================================

# Symbols to trade (comma-separated)
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Risk Management
RISK_PER_TRADE_PCT=1.0      # % of account to risk per trade
MAX_POSITIONS=3              # Maximum concurrent positions
LEVERAGE=10                  # Position leverage (1-125)

# Stop Loss / Take Profit
STOP_LOSS_PCT=1.5           # Stop loss % from entry
TAKE_PROFIT_PCT=3.0         # Take profit % (2:1 R:R ratio)
USE_ATR_STOPS=true          # Use ATR for dynamic stops

# ============================================
# ML Strategy Settings
# ============================================

# Timeframe
TIMEFRAME=15m               # 15m for day trading, 4h for swing

# Model Settings
SIGNAL_THRESHOLD=0.6        # Minimum probability for signal
MIN_CONFIDENCE=0.55         # Minimum confidence to trade
MODEL_RETRAIN_HOURS=24      # Retrain model every N hours

# Scanning
SCAN_INTERVAL=60            # Seconds between scans

# ============================================
# Trendline Strategy Settings (if using)
# ============================================

TRENDLINE_PIVOT_LOOKBACK=5
TRENDLINE_MIN_TOUCHPOINTS=2
TRENDLINE_PRICE_TOLERANCE_PCT=0.5
TRENDLINE_MIN_TIME_SPAN_HOURS=168
TAKE_PROFIT_RR=2.0          # Risk:Reward ratio
